# Copiar a backend/.env (gitignored) y completar.

# Neon > proyecto > Connect > Connection string, con "Connection pooling"
# activado (host terminado en -pooler) y ?sslmode=require.
# Vacío = SQLite local (backend/local.db).
DATABASE_URL=

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambia, todas las sesiones abiertas se cierran.
JWT_SECRET=
# Duración de la sesión en minutos (480 = 8 horas)
JWT_EXPIRA_MIN=480

# Modelo entrenado con ml/train.py (relativo a la raíz del repo)
MODEL_PATH=ml/models/rf_v3.joblib

# Orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000

# Solo desarrollo local con SQLite: sin login. Nunca en producción.
AUTH_DESACTIVADA=0
