# Copiar a backend/.env (gitignored) y completar.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler"
# (compatible con IPv4, necesario en Render). Vacío = SQLite local (backend/local.db).
DATABASE_URL=

# Supabase > Project Settings > API
SUPABASE_URL=https://<proyecto>.supabase.co
# Solo si el proyecto firma con el secreto JWT antiguo (HS256).
# Con claves asimétricas (JWKS) basta SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Modelo entrenado con ml/train.py (relativo a la raíz del repo)
MODEL_PATH=ml/models/rf_v3.joblib

# Orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000

# Solo desarrollo local con SQLite: sin login. Nunca en producción.
AUTH_DESACTIVADA=0
