# Datos reales de estudiantes (Ley N.° 29733) — nunca se versionan
data/raw/
data/processed/

# Modelos entrenados: con pocos casos reales (ej. n=69) el árbol puede
# memorizar alumnos individuales. Solo se versiona un modelo cuando se
# entrena con fuente=historico_real Y el asesor aprueba subirlo; mientras
# tanto se regeneran localmente con ml/train.py y sus métricas se copian
# a mano a docs/MODELO.md.
ml/models/*.joblib
ml/models/*.json

# Entorno y secretos
.env
.env.local
.venv/
__pycache__/

# Frontend
node_modules/
.next/

# Salidas
stats/output/

# Temporales de Office
~$*
